---
import { Icon } from "astro-icon/components";
import "../styles/components/capture.css";

/** Short facts under the copy, revealed in order. */
const FACTS = [
  {
    icon: "lucide:activity",
    text: "Automatic on macOS through launchd. <code>sdt watch</code> on Linux.",
  },
  {
    icon: "lucide:infinity",
    text: "No staging area, no stash, no save you can forget.",
  },
  {
    icon: "lucide:rotate-ccw",
    text: "A rewind captures the state you are leaving first.",
  },
  {
    icon: "lucide:undo-2",
    text: "<code>sdt undo</code> reverses any operation, repo wide.",
  },
];

/**
 * The still frame the page ships with: the playhead parked thirty nine minutes
 * back, the states it left behind still on the tape, and the tape still
 * recording at the live edge. The script picks it up from here.
 */
const HEAD_OFFSET = 26;
const PIN_OFFSET = 5;
const READOUT = "14:02 · 39 minutes back";
---

<section
  class="capture-section mx-auto w-full max-w-[1560px] px-5 sm:px-8 lg:px-14"
  style="animation-fill-mode: backwards"
>
  <article class="capture-card rounded-card bg-surface">
    <header class="capture-copy">
      <h2 style="--i: 0">Nothing is ever unsaved</h2>
      <p style="--i: 1">
        Capture starts at <code>sdt init</code> and never stops. The working copy is always a change.
      </p>

      <ul class="capture-facts" role="list">
        {
          FACTS.map((fact, i) => (
            <li style={`--i: ${i + 2}`}>
              <Icon name={fact.icon} aria-hidden="true" />
              <span set:html={fact.text} />
            </li>
          ))
        }
      </ul>
    </header>

    <div
      class="tape"
      style={`--i: 6; --head-offset: ${HEAD_OFFSET}; --pin-offset: ${PIN_OFFSET}`}
      data-tape
    >
      <div class="tape-status">
        <span class="tape-live-label">
          <i class="tape-dot" aria-hidden="true"></i>
          capture on · <b data-counter>1,284</b> moments
        </span>
        <span class="tape-readout" data-readout>{READOUT}</span>
      </div>

      <div
        class="tape-stage"
        data-stage
        role="img"
        aria-label="A recording tape still capturing at its live edge, with the playhead pulled back thirty nine minutes and every state it left behind still on the tape"
      >
        <div class="tape-flow" data-flow aria-hidden="true">
          <div class="tape-rail"></div>
          <div class="tape-major"></div>
        </div>

        <div class="tape-baseline" aria-hidden="true"></div>
        <div class="tape-wake" data-wake aria-hidden="true"></div>
        <div class="tape-edge" aria-hidden="true"></div>

        <div class="tape-pin" data-pin aria-hidden="true">
          <Icon name="lucide:bookmark" />
        </div>

        <div class="tape-playhead" data-playhead aria-hidden="true">
          <span class="tape-grip">
            <Icon name="lucide:grip-vertical" />
          </span>
        </div>
      </div>
    </div>
  </article>
</section>

<script>
  import { initCaptureTape } from "../scripts/companionScroll";

  const teardowns: Array<() => void> = [];
  teardowns.push(initCaptureTape());

  document.addEventListener("astro:before-swap", () => {
    while (teardowns.length) teardowns.pop()?.();
  });
</script>
