---
import { Icon } from "astro-icon/components";
import "../styles/components/features.css";

/** The six trust badges above the closing CTA. */
const FEATURES = [
  { icon: "lucide:copy", label: "Instant worktrees" },
  { icon: "lucide:binary", label: "Binaries without LFS" },
  { icon: "lucide:rotate-ccw", label: "Reversible rewrites" },
  { icon: "lucide:lock-keyhole", label: "Sealed secrets" },
  { icon: "lucide:share-2", label: "Shared verdicts" },
  { icon: "lucide:message-square-quote", label: "Blame that shows the prompt" },
];
---

<section class="mx-auto w-full max-w-[1560px] px-5 sm:px-8 lg:px-14">
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
    {
      FEATURES.map((feature) => (
        <div class="feature-card flex min-h-[132px] flex-col items-center justify-center gap-3 rounded-card p-4 text-center sm:min-h-[148px] sm:gap-4 sm:p-6">
          <span class="feature-icon" aria-hidden="true">
            <Icon name={feature.icon} />
          </span>
          <span class="feature-label text-[15px] font-medium tracking-[-0.01em]">
            {feature.label}
          </span>
        </div>
      ))
    }
  </div>
</section>
