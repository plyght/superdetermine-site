---
const version = "v0.8.0";
const year = 2026;

const links = [
  { href: "/#vs-git", label: "vs. git" },
  { href: "/#faq", label: "FAQs" },
  { href: "/privacy", label: "Privacy" },
  { href: "/terms", label: "Terms" },
  { href: "https://github.com/plyght/superdetermine/issues", label: "Issues" },
];
---

<footer class="relative z-10 -mt-24 sm:-mt-28">
  <div
    class="mx-auto flex w-full max-w-[1560px] flex-wrap items-center justify-center gap-x-3.5 gap-y-2 px-5 pb-9 text-[13px] tracking-[-0.01em] text-faint sm:px-8 lg:px-14"
  >
    <p>superdetermine {version} · {year}</p>

    <nav class="footer-set flex items-center gap-3.5" aria-label="Source">
      <span class="footer-dot" aria-hidden="true">•</span>
      <a
        class="footer-link"
        href="https://github.com/plyght/superdetermine"
        aria-label="superdetermine on GitHub"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="size-[14px]" aria-hidden="true">
          <path
            d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
          ></path>
        </svg>
      </a>
    </nav>

    {
      links.map((link) => (
        <span class="footer-set">
          <span class="footer-dot" aria-hidden="true">
            •
          </span>
          <a class="footer-link" href={link.href}>
            {link.label}
          </a>
        </span>
      ))
    }
  </div>
</footer>

<style>
  .footer-link {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
    transition: color 0.16s ease;
  }

  .footer-link:hover {
    color: var(--color-fg);
  }

  .footer-set {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    white-space: nowrap;
  }

  .footer-dot {
    opacity: 0.55;
    user-select: none;
  }

  @media (max-width: 639px) {
    .footer-dot {
      display: none;
    }
  }
</style>
