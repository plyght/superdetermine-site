---
import { MARK_INK_VIEWBOX, MARK_PATH } from "../brand";

interface Props {
  class?: string;
}

const { class: className = "size-[22px] text-white" } = Astro.props;
---

<!-- The explicit width/height keep the unlayered
     `:where(svg:not([width]):not([height]))` first-paint fallback from
     overriding the sizing utilities, which live in @layer utilities. -->
<svg
  viewBox={MARK_INK_VIEWBOX}
  width="343"
  height="311"
  fill="none"
  class={className}
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <path d={MARK_PATH} fill="currentColor" fill-rule="evenodd"></path>
</svg>
