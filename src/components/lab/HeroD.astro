---
import BuyButton from "../BuyButton.astro";
import Logo from "../Logo.astro";
import "../../styles/components/lab/hero-d.css";
---

<div class="mx-auto w-full max-w-[1560px] px-5 sm:px-8 lg:px-14">
  <section
    data-wave-host
    data-keep-dark
    data-hero-d
    class="hero-d group relative isolate overflow-hidden rounded-card"
  >
    <!-- The path integral. Every history from source to detector at once, each
         carrying its phase. The CSS gradient is the pre-paint look and the
         fallback when WebGL2 is unavailable. -->
    <canvas
      data-hero-d-canvas
      class="hero-d-canvas absolute inset-0 h-full w-full"
      aria-hidden="true"></canvas>

    <div
      class="pointer-events-none absolute inset-0 z-10 rounded-card ring-1 ring-inset ring-white/10"
    >
    </div>

    <div
      class="relative z-20 flex min-h-[600px] flex-col justify-between gap-10 p-6 sm:min-h-[540px] sm:p-8"
    >
      <h1
        class="max-w-[900px] text-[clamp(36px,6.9vw,66px)] font-semibold leading-[1.08] tracking-[-0.025em] text-white drop-shadow-[0_1px_14px_rgba(0,20,10,0.45)]"
        data-hero-headline
      >
        superdetermine is a version control system, keeping code in superposition.
      </h1>

      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="mb-3 flex flex-col gap-6" data-hero-d-avoid>
          <Logo class="size-9 text-white drop-shadow-[0_2px_8px_rgba(0,20,10,0.45)]" />
          <span class="text-[20px] font-semibold tracking-[-0.02em] text-white">superdetermine</span
          >
        </div>

        <div data-hero-d-avoid>
          <BuyButton variant="hero" />
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  import { initHeroD } from "../../scripts/lab/heroD";
  import { initHeroHeadline } from "../../scripts/heroHeadline";

  const teardowns: Array<() => void> = [];

  document.querySelectorAll<HTMLElement>("[data-hero-d]").forEach((host) => {
    const canvas = host.querySelector<HTMLCanvasElement>("canvas[data-hero-d-canvas]");
    if (canvas) teardowns.push(initHeroD(canvas, host));
  });

  initHeroHeadline();

  document.addEventListener("astro:before-swap", () => {
    while (teardowns.length) teardowns.pop()?.();
  });
</script>
