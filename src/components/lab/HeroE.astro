---
import BuyButton from "../BuyButton.astro";
import Logo from "../Logo.astro";
import "../../styles/components/lab/hero-e.css";
---

<div class="mx-auto w-full max-w-[1560px] px-5 sm:px-8 lg:px-14">
  <section
    data-wave-host
    data-carpet-host
    data-keep-dark
    class="carpet-host group relative isolate overflow-hidden rounded-card"
  >
    <!-- The quantum carpet. The card's CSS gradient is the pre-paint look and
         the fallback when WebGL is unavailable; the shader repaints the same
         gradient as its own base. -->
    <canvas data-carpet class="carpet-canvas absolute inset-0 h-full w-full" aria-hidden="true"
    ></canvas>

    <div
      class="pointer-events-none absolute inset-0 z-10 rounded-card ring-1 ring-inset ring-white/10"
    >
    </div>

    <div
      class="relative z-20 flex min-h-[440px] flex-col justify-between gap-10 p-6 sm:min-h-[500px] sm:p-8"
    >
      <h1
        class="max-w-[900px] text-[clamp(36px,6.9vw,66px)] font-semibold leading-[1.08] tracking-[-0.025em] text-white drop-shadow-[0_1px_14px_rgba(0,20,10,0.5)]"
        data-hero-headline
      >
        superdetermine is a version control system, keeping code in superposition.
      </h1>

      <div class="flex flex-wrap items-end justify-between gap-4" data-carpet-foot>
        <div class="mb-3 flex flex-col gap-6">
          <Logo class="size-9 text-white drop-shadow-[0_2px_8px_rgba(0,20,10,0.45)]" />
          <span class="text-[20px] font-semibold tracking-[-0.02em] text-white">superdetermine</span
          >
        </div>

        <BuyButton variant="hero" />
      </div>
    </div>
  </section>
</div>

<script>
  import { initHeroE } from "../../scripts/lab/heroE";
  import { initHeroHeadline } from "../../scripts/heroHeadline";

  const teardowns: Array<() => void> = [];

  document.querySelectorAll<HTMLCanvasElement>("canvas[data-carpet]").forEach((canvas) => {
    const host = canvas.closest<HTMLElement>("[data-carpet-host]") ?? canvas.parentElement;
    if (host) teardowns.push(initHeroE(canvas, host));
  });

  initHeroHeadline();

  document.addEventListener("astro:before-swap", () => {
    while (teardowns.length) teardowns.pop()?.();
  });
</script>
