---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import { Agentation } from "agentation";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  description: string;
  intro?: boolean;
}

const { title, description, intro = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og/superdetermine-og.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="mask-icon" href="/favicon.svg" color="#0a0a0a" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <!-- sdt ships macOS and Linux binaries only, so the label names the visitor's
         platform when it is one of those and stays generic otherwise, rather
         than offering a build that does not exist. Inline so the label is
         correct at first paint instead of flipping after hydration. -->
    <script is:inline>
      (() => {
        const ua = navigator.userAgent || "";
        const plat =
          (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || "";

        function detect() {
          // Android reports "Linux" and ChromeOS reports "X11", and neither runs sdt.
          if (/Android/i.test(ua) || /CrOS/i.test(ua)) return null;
          // iPadOS claims to be a Mac; a touch-capable "Mac" is not one.
          if (/Mac/i.test(plat) && navigator.maxTouchPoints > 1) return null;
          if (/Mac/i.test(plat)) return "macOS";
          if (/Linux|X11/i.test(plat)) return "Linux";
          return null;
        }

        const os = detect();
        const label = os ? "Download for " + os : "Download";

        function apply() {
          document.querySelectorAll("[data-buy-btn] .buy-label").forEach((el) => {
            el.textContent = label;
          });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", apply, { once: true });
        } else {
          apply();
        }
      })();
    </script>
    <script is:inline>
      (() => {
        let theme = "dark";
        try {
          const stored = localStorage.getItem("sdt:theme");
          theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
        } catch (e) {
          /* default dark */
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <style is:inline>
      html {
        background-color: #0a0a0a;
        color: #fff;
      }
      html[data-theme="light"] {
        background-color: #f2f1ef;
        color: #161615;
      }
      body {
        margin: 0;
        background-color: inherit;
        color: inherit;
      }
      a {
        color: inherit;
      }
      :where(svg:not([width]):not([height])) {
        width: 1em;
        height: 1em;
      }
    </style>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:text-black"
    >
      Skip to content
    </a>
    <!-- The intro animations are written as `[data-intro] > header` and
         `[data-intro] main > section`, so this wrapper has to be the direct
         parent of both. Its pt-2 is also the page's top offset. -->
    <div
      id="top"
      class="relative min-h-screen w-full overflow-x-clip pt-2"
      data-intro={intro ? "" : undefined}
    >
      <Nav />
      <slot />
    </div>
    {import.meta.env.DEV && <Agentation client:only="react" />}
    <Analytics />
  </body>
</html>
